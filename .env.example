# ====================================================
# Smart PR Inspector Agent — 환경변수 설정
# 이 파일을 .env로 복사하여 실제 값을 입력하세요
# ====================================================

# ── GitHub ──────────────────────────────────────────
# GitHub Personal Access Token (repo, pull_requests 권한 필요)
GITHUB_TOKEN=ghp_your_github_token_here

# GitHub Webhook 서명 검증 시크릿
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# 기본 레포지토리 (Slack 승인 시 사용)
GITHUB_REPO=owner/repo

# ── LLM API ─────────────────────────────────────────
# Anthropic Claude API Key (필수)
ANTHROPIC_API_KEY=sk-ant-your_api_key_here

# 사용할 Claude 모델
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI API Key (선택, 폴백용)
OPENAI_API_KEY=sk-your_openai_key_here

# ── Slack ────────────────────────────────────────────
# Slack Bot Token (xoxb-로 시작)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Slack Signing Secret (Webhook 검증용)
SLACK_SIGNING_SECRET=your_signing_secret

# 알림을 보낼 Slack 채널
SLACK_CHANNEL=#code-review

# ── 데이터베이스 ──────────────────────────────────────
# PostgreSQL (리뷰 이력 저장)
DATABASE_URL=postgresql://postgres:password@localhost:5432/pr_inspector

# Redis (캐싱)
REDIS_URL=redis://localhost:6379

# ── Vector DB (ChromaDB) ──────────────────────────────
# 로컬 ChromaDB 서버 (docker-compose로 실행)
CHROMA_HOST=localhost
CHROMA_PORT=8001

# 로컬 ChromaDB 퍼시스턴트 경로 (HttpClient 미사용 시)
CHROMA_PERSIST_DIR=./.chroma

# Pinecone (선택, 클라우드 벡터 DB)
PINECONE_API_KEY=your_pinecone_key_here
PINECONE_ENV=us-east-1-aws

# ── 앱 설정 ──────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# 프론트엔드 URL (CORS 설정)
FRONTEND_URL=http://localhost:3000

# FastAPI 서버 포트
API_PORT=8000

# ── 모니터링 (선택) ───────────────────────────────────
# Sentry DSN (에러 추적)
SENTRY_DSN=https://your_sentry_dsn_here

# ── 프론트엔드 (.env.local) ────────────────────────────
# Next.js 환경변수 (NEXT_PUBLIC_는 클라이언트에 노출됨)
NEXT_PUBLIC_API_URL=http://localhost:8000
ANTHROPIC_API_KEY=sk-ant-your_api_key_here
